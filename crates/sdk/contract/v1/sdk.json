{
  "$defs": {
    "ApiDescription": {
      "description": "The `DescribeApi` result: what the engine a client is connected to serves.",
      "properties": {
        "apiVersion": {
          "description": "The operation contract version ([`CATALOG_VERSION`]). A client refuses\nan engine with a different API version instead of guessing.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "engineVersion": {
          "description": "The serving engine's build version.",
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/OperationRef"
          },
          "type": "array"
        }
      },
      "required": [
        "apiVersion",
        "engineVersion",
        "operations"
      ],
      "type": "object"
    },
    "ClientFrame": {
      "description": "A call ({id, method, params}) or the cancellation of a stream ({id, cancel: true}).",
      "oneOf": [
        {
          "not": {
            "required": [
              "cancel"
            ]
          },
          "required": [
            "method"
          ]
        },
        {
          "not": {
            "required": [
              "method"
            ]
          },
          "required": [
            "cancel"
          ]
        }
      ],
      "properties": {
        "cancel": {
          "const": true
        },
        "id": {
          "minimum": 0,
          "type": "integer"
        },
        "method": {
          "description": "A catalogued operation's wire method name.",
          "type": "string"
        },
        "params": {
          "description": "Operation parameters; omitted or null means none."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "CommandReasonCode": {
      "enum": [
        "commandIdConflict",
        "staleTaskRevision",
        "staleBindingGeneration",
        "staleTurn",
        "queueRevisionConflict",
        "queueClaimed",
        "queueMissing",
        "activeTurnConflict",
        "foreignActive",
        "invalidDestination",
        "incompatibleWorkspace",
        "incompatibleEnvironment",
        "providerAcceptanceUnknown",
        "transactionFailed",
        "unsupportedOperation",
        "operationRejected",
        "operationFailed",
        "permissionModeRequired"
      ],
      "type": "string"
    },
    "CommandReceipt": {
      "properties": {
        "acceptedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "actorId": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "clientSessionId": {
          "type": "string"
        },
        "commandId": {
          "type": "string"
        },
        "committedAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "correlationId": {
          "description": "Engine/provider correlation used to finalize a pending send only after\nthe provider confirms the matching turn/message boundary.",
          "type": [
            "string",
            "null"
          ]
        },
        "eventSequence": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "executionEnvironment": {
          "type": [
            "string",
            "null"
          ]
        },
        "intent": {
          "type": "string"
        },
        "observedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "payloadHash": {
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandReceiptReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "recoveryAction": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot": {
          "$ref": "#/$defs/TaskCommandSnapshot"
        },
        "status": {
          "$ref": "#/$defs/CommandReceiptStatus"
        },
        "taskId": {
          "type": "string"
        }
      },
      "required": [
        "commandId",
        "taskId",
        "intent",
        "payloadHash",
        "status",
        "snapshot",
        "actorId",
        "clientId",
        "clientSessionId",
        "acceptedAtMs",
        "observedAtMs"
      ],
      "type": "object"
    },
    "CommandReceiptReason": {
      "properties": {
        "code": {
          "$ref": "#/$defs/CommandReasonCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "CommandReceiptStatus": {
      "enum": [
        "pending",
        "applied",
        "rejected",
        "conflict",
        "superseded",
        "failed"
      ],
      "type": "string"
    },
    "EmptyParams": {
      "description": "Parameters of an operation that takes none.",
      "type": "object"
    },
    "EngineInfo": {
      "description": "Stable information about the engine runtime reached by a client.",
      "properties": {
        "capabilities": {
          "description": "Supported protocol/document features. Missing on older engines.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deviceId": {
          "type": "string"
        },
        "profileId": {
          "description": "Stable opaque identity for the resolved profile, not just this device.\nAbsent on older engines and before an account/local profile is resolved.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceScope": {
          "$ref": "#/$defs/WorkspaceScope"
        }
      },
      "required": [
        "deviceId",
        "workspaceScope"
      ],
      "type": "object"
    },
    "ExecuteTaskCommandParams": {
      "description": "The `ExecuteTaskCommand` envelope as the SDK sends it. Absent optional\nfields are omitted, so the engine applies its documented defaults.",
      "properties": {
        "actorId": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "clientSessionId": {
          "type": "string"
        },
        "commandId": {
          "description": "Stable idempotency key, minted once before the first send.",
          "type": "string"
        },
        "expectedBindingGeneration": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "expectedTaskRevision": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "expectedTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "intent": {
          "$ref": "#/$defs/TaskIntent"
        },
        "issuedAtMs": {
          "description": "Client issue time in Unix milliseconds; omitted, the engine's receive time.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "targetDeviceId": {
          "description": "The task's execution host, when it is not the connected engine.",
          "type": [
            "string",
            "null"
          ]
        },
        "taskId": {
          "type": "string"
        }
      },
      "required": [
        "commandId",
        "actorId",
        "clientId",
        "clientSessionId",
        "taskId",
        "intent"
      ],
      "type": "object"
    },
    "OperationRef": {
      "description": "One served operation, as `DescribeApi` reports it (CORE-05). `kind` and\n`reply` stay strings so an older reader keeps a newer engine's values.",
      "properties": {
        "id": {
          "description": "Stable namespaced operation id (`luna.core/<operation>`).",
          "type": "string"
        },
        "kind": {
          "description": "`query`, `command` or `watch`.",
          "type": "string"
        },
        "method": {
          "description": "Legacy wire method name.",
          "type": "string"
        },
        "reply": {
          "description": "`unary`, `stream` or `streamAfterReady`.",
          "type": "string"
        },
        "version": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "method",
        "kind",
        "reply"
      ],
      "type": "object"
    },
    "ProjectionCurrent": {
      "description": "A `current` answer: the client's cursor still names this host's state.",
      "properties": {
        "cursor": {
          "$ref": "#/$defs/ProjectionCursor"
        },
        "host": {
          "$ref": "#/$defs/ProjectionHost"
        },
        "observedAtMs": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "host",
        "cursor",
        "observedAtMs"
      ],
      "type": "object"
    },
    "ProjectionCursor": {
      "description": "Where a projection is in its host's history.",
      "properties": {
        "generation": {
          "description": "Fresh per engine start; revisions compare only within one generation.",
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "generation",
        "revision"
      ],
      "type": "object"
    },
    "ProjectionHost": {
      "description": "The host a projection describes. A client checks it against the host it\npaired with before applying anything.",
      "properties": {
        "capabilities": {
          "description": "What this host serves remotely for these projections and tasks, for\nexample `remote-projections-v1`. Task control is absent until a host\nadmits remote commands (RM-04).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deviceId": {
          "type": "string"
        },
        "engineVersion": {
          "type": "string"
        },
        "environmentId": {
          "description": "The remote environment (profile) id paired clients target; absent\nwhen this engine has no remote authority store.",
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "type": "string"
        },
        "profileId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceScope": {
          "$ref": "#/$defs/WorkspaceScope"
        }
      },
      "required": [
        "deviceId",
        "workspaceScope",
        "generation",
        "engineVersion",
        "capabilities"
      ],
      "type": "object"
    },
    "ProviderReadiness": {
      "description": "A provider (harness) on this host and whether it can run work.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "installed": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "installed",
        "enabled"
      ],
      "type": "object"
    },
    "RemoteFollowUp": {
      "description": "How a message sent while a turn runs waits.",
      "oneOf": [
        {
          "const": "queue",
          "description": "Wait for the running turn to end, then start the next one.",
          "type": "string"
        },
        {
          "const": "steer",
          "description": "Steer the running turn when its provider takes prompts mid-turn;\notherwise it stays queued until an explicit send.",
          "type": "string"
        }
      ]
    },
    "RemoteHistoryEntry": {
      "description": "One transcript entry, reduced to what a list shows.",
      "properties": {
        "createdAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "entryId": {
          "type": "string"
        },
        "error": {
          "type": "boolean"
        },
        "otherParts": {
          "description": "Parts not shown here (images, reasoning, questions, extra tools).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "description": "`user`, `assistant` or `system`.",
          "type": "string"
        },
        "status": {
          "description": "`streaming`, `complete` or `aborted`, when the entry has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "The entry's text parts, joined and bounded.",
          "type": "string"
        },
        "textTruncated": {
          "type": "boolean"
        },
        "tools": {
          "description": "The kind of each tool call, in order and bounded.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "entryId",
        "role",
        "createdAtMs",
        "text",
        "textTruncated",
        "tools",
        "otherParts",
        "error"
      ],
      "type": "object"
    },
    "RemoteNewWorktree": {
      "additionalProperties": false,
      "description": "A task's first message runs in a new git worktree of its project.",
      "properties": {
        "base": {
          "description": "The ref the worktree's new branch starts from; the project's current\n`HEAD` when absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RemotePermissionMode": {
      "description": "The permission mode a phone may choose for a task it creates. New work\nhas only these two: Full access never asks, and Auto lets the provider's\nown reviewer decide. Legacy Ask is not representable (it is refused as a\nmalformed command).",
      "enum": [
        "full",
        "auto"
      ],
      "type": "string"
    },
    "RemoteProject": {
      "description": "One project, by display name only.",
      "properties": {
        "name": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "name"
      ],
      "type": "object"
    },
    "RemoteTaskCommand": {
      "additionalProperties": false,
      "description": "`ExecuteRemoteTaskCommand` parameters: one phone command. Unknown fields\n(an `actorId`, a `clientId`, a raw engine intent) are refused, never\nignored: the principal comes only from the authenticated connection.",
      "properties": {
        "commandId": {
          "description": "Stable idempotency key: minted once before the first send, reused\nfor every retry and receipt read. 1-128 bytes of `[A-Za-z0-9._:-]`.",
          "type": "string"
        },
        "expectedBindingGeneration": {
          "description": "`expectedBindingGeneration`: required once the task has a provider\nbinding, except for `createTask` and `cancelCapacityWait`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "expectedTaskRevision": {
          "description": "`expectedTaskRevision`: required by `setArchived`.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "expectedTurnId": {
          "description": "`expectedTurnId`: required by `stop` and `steerQueuedNow`, and by\n`sendQueuedNow` while a turn runs.",
          "type": [
            "string",
            "null"
          ]
        },
        "intent": {
          "$ref": "#/$defs/RemoteTaskIntent"
        },
        "issuedAtMs": {
          "description": "The phone's issue time (Unix ms); the host clamps it to its own clock.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "taskId": {
          "description": "The target task. For `createTask`, the new task's id: a UUID the\nphone mints, so a retried create names the same task.",
          "type": "string"
        }
      },
      "required": [
        "commandId",
        "taskId",
        "intent"
      ],
      "type": "object"
    },
    "RemoteTaskDelta": {
      "description": "A task's changes from `base` to `cursor`.",
      "properties": {
        "base": {
          "$ref": "#/$defs/ProjectionCursor"
        },
        "cursor": {
          "$ref": "#/$defs/ProjectionCursor"
        },
        "observedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "order": {
          "description": "The complete entry order after this delta, when it changed. Always\npresent when an entry was added or removed.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "remove": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteTaskRow"
            },
            {
              "type": "null"
            }
          ],
          "description": "The task's row, when it changed."
        },
        "taskRevision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "taskSequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "totalEntries": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "upsert": {
          "items": {
            "$ref": "#/$defs/RemoteHistoryEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "base",
        "cursor",
        "observedAtMs",
        "taskRevision",
        "taskSequence",
        "upsert",
        "remove",
        "totalEntries"
      ],
      "type": "object"
    },
    "RemoteTaskDetail": {
      "description": "One task in detail: the first item of a watch without a current cursor.",
      "properties": {
        "cursor": {
          "$ref": "#/$defs/ProjectionCursor"
        },
        "entries": {
          "description": "The newest entries, oldest first.",
          "items": {
            "$ref": "#/$defs/RemoteHistoryEntry"
          },
          "type": "array"
        },
        "host": {
          "$ref": "#/$defs/ProjectionHost"
        },
        "observedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "task": {
          "$ref": "#/$defs/RemoteTaskRow"
        },
        "taskRevision": {
          "description": "The task's durable command revision and sequence (CORE-05).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "taskSequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "totalEntries": {
          "description": "Every entry in the transcript; more than `entries.len()` when bounded.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "host",
        "cursor",
        "observedAtMs",
        "task",
        "taskRevision",
        "taskSequence",
        "entries",
        "totalEntries"
      ],
      "type": "object"
    },
    "RemoteTaskIntent": {
      "description": "What a paired phone may ask its Mac to do with one task.",
      "oneOf": [
        {
          "description": "Create the command's task in a project this host lists. Its folder\nand provider come from the host, never the phone. `permissionMode`\n(`full` or `auto`) is recorded in the task's configuration; without\none the host uses Auto when its provider and model support it, and\notherwise refuses the create (`permissionModeRequired`) before any\nprovider work.",
          "properties": {
            "kind": {
              "const": "createTask",
              "type": "string"
            },
            "permissionMode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RemotePermissionMode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "projectId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "projectId"
          ],
          "type": "object"
        },
        {
          "description": "Send a message (its id becomes the transcript message id). To an\nidle task it starts the next turn, as a desktop send does; while the\ntask is busy (a running turn, or an earlier send still preparing its\nturn or worktree) it waits in the host's durable queue (`queue`) or\nsteers the running turn (`steer`). With `newWorktree` (only for a task\nthat has never run) it starts the task's first turn in a fresh\nworktree; later messages wait behind that worktree's setup and are\nheld if the setup fails or is cancelled.",
          "properties": {
            "followUp": {
              "$ref": "#/$defs/RemoteFollowUp",
              "default": "queue"
            },
            "kind": {
              "const": "send",
              "type": "string"
            },
            "messageId": {
              "type": "string"
            },
            "newWorktree": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RemoteNewWorktree"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "messageId",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "Remove a queued message, fenced by its queue revision.",
          "properties": {
            "expectedQueueRevision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "removeQueued",
              "type": "string"
            },
            "messageId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "messageId",
            "expectedQueueRevision"
          ],
          "type": "object"
        },
        {
          "description": "Interrupt the running turn (if any) and send this queued message now.",
          "properties": {
            "expectedQueueRevision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "sendQueuedNow",
              "type": "string"
            },
            "messageId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "messageId",
            "expectedQueueRevision"
          ],
          "type": "object"
        },
        {
          "description": "Steer this queued message into the running turn without stopping it.",
          "properties": {
            "expectedQueueRevision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "steerQueuedNow",
              "type": "string"
            },
            "messageId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "messageId",
            "expectedQueueRevision"
          ],
          "type": "object"
        },
        {
          "description": "Stop the expected running turn. Accepted work elsewhere is untouched.",
          "properties": {
            "kind": {
              "const": "stop",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Archive or restore the task.",
          "properties": {
            "archived": {
              "type": "boolean"
            },
            "kind": {
              "const": "setArchived",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "archived"
          ],
          "type": "object"
        },
        {
          "description": "Withdraw a send that started a turn (its receipt is `run`) while it\nwaits for a free turn on the host. A send that started is refused.",
          "properties": {
            "commandId": {
              "type": "string"
            },
            "kind": {
              "const": "cancelCapacityWait",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "commandId"
          ],
          "type": "object"
        }
      ]
    },
    "RemoteTaskItem": {
      "description": "One `WatchRemoteTask` item.",
      "oneOf": [
        {
          "description": "The whole task; replaces anything the client holds for it.",
          "properties": {
            "detail": {
              "$ref": "#/$defs/RemoteTaskDetail"
            },
            "kind": {
              "const": "snapshot",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "detail"
          ],
          "type": "object"
        },
        {
          "description": "The client's cursor is current; nothing was resent.",
          "properties": {
            "current": {
              "$ref": "#/$defs/ProjectionCurrent"
            },
            "kind": {
              "const": "current",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "current"
          ],
          "type": "object"
        },
        {
          "properties": {
            "delta": {
              "$ref": "#/$defs/RemoteTaskDelta"
            },
            "kind": {
              "const": "delta",
              "type": "string"
            }
          },
          "required": [
