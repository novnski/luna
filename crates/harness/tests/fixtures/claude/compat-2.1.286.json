    "process": {
      "idle_stdin_eof_exit": "exit 0 within ~7 ms (probe)",
      "idle_sigterm_exit": "exit 143 within ~9 ms (probe)",
      "luna_stop": "interrupt(cancel_queued) -> wait for the interrupted result -> close stdin -> wait up to kill_grace -> SIGTERM -> SIGKILL; an unresponsive CLI still escalates at interrupt_grace"
    }
