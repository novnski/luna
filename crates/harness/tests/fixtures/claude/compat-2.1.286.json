  "transport": {
    "sources": [
      "zod SDK schema descriptions embedded in the installed binary (strings)",
      "initialization-only control handshakes, no user message: evidence/cc01-transport/probes/run-1",
      "@anthropic-ai/claude-agent-sdk 0.3.276 sdk.mjs dispatch (the version T3 pins)"
    ],
    "flags": [
      "--print",
      "--input-format",
      "stream-json",
      "--output-format",
      "stream-json",
      "--verbose",
      "--include-partial-messages",
      "--thinking-display",
      "summarized",
      "--permission-prompt-tool",
      "stdio"
    ],
    "flags_note": "The Agent SDK spawns the same CLI with the same --output-format/--input-format stream-json and --permission-prompt-tool stdio; every SDK Query method is a control_request on this stream.",
    "policy_observations": {
      "ask_initialize_current_permission_mode": "acceptEdits",
      "auto_initialize_current_permission_mode": "auto",
      "set_permission_mode_bypass_under_restricted": "error, error_code=bypass_restricted, 'bypassPermissions not supported in restricted mode'"
    },
    "capability_use": {
      "interrupt_receipt_v1": "decode still_queued on the interrupt reply",
      "interrupt_cancel_queued_v1": "Stop always sends cancel_queued:true (documented as ignored by older CLIs); cancelled uuids reject unreceipted explicit steers",
      "msg_lifecycle_v1": "uuid-stamped stdin user lines; explicit steer acceptance waits for queued, incorporation needs started"
    },
    "capability_rule": "feature-detect from the advertised set; never version-sniff; unknown names are retained and ignored",
    "capabilities_other_known_names": [
      "task_list_restore_v1",
      "task_list_restored_v1",
      "mcp_tool_ui_meta_v1",
      "mcp_read_resource_v1",
      "queued_notifications"
    ],
    "inbound_requests": [
      {
        "subtype": "can_use_tool",
        "luna": "handled",
        "detail": "approval through the engine input bridge; AskUserQuestion answers via updatedInput; Full allows"
      },
      {
        "subtype": "hook_callback",
        "luna": "unsupported_error",
        "detail": "LUNA registers no SDK hooks in initialize, so this is never expected"
      },
      {
        "subtype": "mcp_message",
        "luna": "unsupported_error",
        "detail": "no SDK-hosted MCP servers registered; candidate transport for the CC-07 callable bridge"
      },
      {
        "subtype": "elicitation",
        "luna": "unsupported_error",
        "detail": "MCP form/URL elicitation; mapping owned by cc03-permissions"
      },
      {
        "subtype": "request_user_dialog",
        "luna": "unsupported_error",
        "detail": "native dialogs; mapping owned by cc03-permissions"
      },
      {
        "subtype": "oauth_token_refresh",
        "luna": "unsupported_error",
        "detail": "only sent to hosts that supplied an OAuth token"
      },
      {
        "subtype": "host_auth_token_refresh",
        "luna": "unsupported_error",
        "detail": "hosted/remote sessions only"
      },
      {
        "subtype": "remote_control_work_secret",
        "luna": "unsupported_error",
        "detail": "Remote Control hosts only"
      },
      {
        "subtype": "luna_future_subtype",
        "luna": "unsupported_error",
        "detail": "synthetic future subtype: every unrecognised subtype gets an explicit error reply"
      }
    ],
    "inbound_frames": [
      {
        "type": "control_cancel_request",
        "luna": "handled",
        "detail": "aborts the in-flight waiter for that request id; no late reply; unknown ids ignored"
      },
      {
        "type": "control_response",
        "luna": "handled",
        "detail": "correlated to LUNA's outbound request id; unmatched/late replies ignored"
      },
      {
        "type": "command_lifecycle",
        "luna": "handled",
        "detail": "queued/started/completed/cancelled/discarded/refused for LUNA-minted uuids; foreign uuids and duplicates ignored"
      },
      {
        "type": "keep_alive",
        "luna": "ignored"
      },
      {
        "type": "auth_status",
        "luna": "observe_only",
        "detail": "falls to wire Frame::Other; sign-in failures surface through assistant error codes"
      },
      {
        "type": "transcript_mirror",
        "luna": "observe_only"
      },
      {
        "type": "conversation_reset",
        "luna": "not_decoded",
        "owner": "cc02-events / cc10-history"
      },
      {
        "type": "tool_progress",
        "luna": "not_decoded",
        "owner": "cc02-events"
      },
      {
        "type": "tool_use_summary",
        "luna": "not_decoded",
        "owner": "cc02-events"
      },
      {
        "type": "prompt_suggestion",
        "luna": "not_decoded",
        "owner": "cc02-events"
      },
      {
        "type": "active_goal",
        "luna": "not_decoded",
        "owner": "cc14-goals-review"
      },
      {
        "type": "autocompact_state",
        "luna": "not_decoded",
        "owner": "cc02-events"
      }
    ],
    "outbound_requests": [
      {
        "subtype": "initialize",
        "luna": "sent",
        "where": "command/model discovery probe (cc00 launch profile: same binary, home, cwd and policy flags as the run)",
        "probe": "success; capabilities subset, current_permission_mode, models, commands"
      },
      {
        "subtype": "interrupt",
        "luna": "sent",
        "where": "Stop",
        "shape": {
          "request_id": "luna-interrupt-<n>",
          "cancel_queued": true
        },
        "probe": "idle: {still_queued:[]}; with cancel_queued: {still_queued:[], cancelled:[]}"
      },
      {
        "subtype": "set_permission_mode",
        "luna": "not_sent",
        "probe": "same mode: {mode}; bypassPermissions under --restricted: error bypass_restricted",
        "candidate_owner": "cc06-models-usage"
      },
      {
        "subtype": "set_model",
        "luna": "not_sent",
        "note": "error_code values: invalid_request, catalog_unknown, restricted_by_org, unavailable_for_account, not_offered, alias_1m_disabled, alias_1m_unsupported, blocked_by_hook, check_failed",
        "candidate_owner": "cc06-models-usage"
      },
      {
        "subtype": "set_max_thinking_tokens",
        "luna": "not_sent",
        "probe": "null reset: success, empty payload"
      },
      {
        "subtype": "apply_flag_settings",
        "luna": "not_sent",
        "probe": "{}: success, empty payload"
      },
      {
        "subtype": "get_settings",
        "luna": "not_sent",
        "probe": "success: {effective, sources, applied:{model, effort, advisor, ultracode, ultracodeRequested, ultracodeAvailable}}; isolated config: effective {} and sources []"
      },
      {
        "subtype": "mcp_status",
        "luna": "not_sent",
        "probe": "success: {mcpServers:[]}",
        "candidate_owner": "cc11-mcp-inventory"
      },
      {
        "subtype": "cancel_async_message",
        "luna": "not_sent",
        "probe": "unknown uuid: {cancelled:false}"
      },
      {
        "subtype": "stop_task",
        "luna": "not_sent",
        "probe": "unknown task id: success, empty payload (no error)",
        "candidate_owner": "cc08-native-agents"
      },
      {
        "subtype": "get_binary_version",
        "luna": "not_sent",
        "probe": "success: {version:'2.1.286', buildTime}"
      },
      {
        "subtype": "rewind_files",
        "luna": "not_sent",
        "candidate_owner": "cc10-history"
      },
      {
        "subtype": "get_context_usage",
        "luna": "not_sent",
        "candidate_owner": "cc06-models-usage"
      },
      {
        "subtype": "reload_plugins",
        "luna": "not_sent",
        "candidate_owner": "cc12-extensions"
      },
      {
        "subtype": "unknown subtype",
        "luna": "n/a",
        "probe": "error: 'Unsupported control request subtype: <name>' (the CLI's own unknown-request reply, same wording LUNA now uses)"
      }
